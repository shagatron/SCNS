# Local development only. Copy to .env; never use these demo credentials publicly.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://scns:scns_local@localhost:54329/scns
TEST_DATABASE_URL=postgresql+psycopg://scns:scns_local@localhost:54329/scns_test
DEMO_ENABLED=true
WALKING_SPEED_MPS=1.4
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
STORAGE_ROOT=../storage
# Optional approved tile provider; blank = synthetic campus layers only, no tile requests.
VITE_BASEMAP_URL=
VITE_BASEMAP_ATTRIBUTION=
# M2A admin: bootstrap via the trusted-host CLI; never put passwords here.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
LOGIN_ACCOUNT_LIMIT=5
LOGIN_IP_LIMIT=30
LOGIN_WINDOW_SECONDS=900
# Test-only URLs: browser/migration runners reset only their dedicated databases.
# E2E_DATABASE_URL=postgresql+psycopg://scns:scns_local@localhost:54329/scns_e2e_test
# MIGRATION_DATABASE_URL=postgresql+psycopg://scns:scns_local@localhost:54329/scns_migration_test
# Private uploads and QR are implemented; offline packs remain a later slice.

# Private staged imports; API and worker must use the same storage/database.
IMPORT_BYTE_LIMIT=5242880
IMPORT_ROW_LIMIT=2000
IMPORT_PARSE_SECONDS=30
IMPORT_STORAGE_LIMIT=104857600

# QR signs: HTTPS canonical origin required off-loopback; no deployment implied.
PUBLIC_APP_URL=http://localhost:5173
