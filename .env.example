# Local development only. Copy to .env; never use these demo credentials publicly.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://scns:scns_local@localhost:54329/scns
TEST_DATABASE_URL=postgresql+psycopg://scns:scns_local@localhost:54329/scns_test
DEMO_ENABLED=true
WALKING_SPEED_MPS=1.4
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
STORAGE_ROOT=../storage
# Optional approved tile provider; blank = synthetic campus layers only, no tile requests.
VITE_BASEMAP_URL=
VITE_BASEMAP_ATTRIBUTION=
# Admin sessions, uploads, offline caches, QR origins and external integrations are
# not enabled in M0/M1. Configure them when their milestones are implemented.
