        "entity": {
          "const": "connectors",
          "title": "Entity",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConnectorFields"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "entity",
        "id"
      ],
      "title": "ConnectorChange",
      "type": "object"
    },
    "ConnectorFields": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "default": "",
          "maxLength": 2000,
          "title": "Evidence",
          "type": "string"
        },
        "verified_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified On"
        },
        "visibility": {
          "default": "public",
          "enum": [
            "public",
            "restricted"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "building_id": {
          "format": "uuid",
          "title": "Building Id",
          "type": "string"
        },
        "code": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Code",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "stairs",
            "lift",
            "ramp",
            "entrance"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operational_status": {
          "default": "unknown",
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ],
          "title": "Operational Status",
          "type": "string"
        }
      },
      "required": [
        "building_id",
        "code",
        "label",
        "kind"
      ],
      "title": "ConnectorFields",
      "type": "object"
    },
